# Copy to .env and fill in. Never commit .env.

# Which provider to try first: ollama or groq. The other is the fallback.
LLM_PROVIDER=ollama

# Local Ollama (no key needed). These are the defaults.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b

# Groq (free tier key from console.groq.com). Without a key, Groq is skipped as a fallback.
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
